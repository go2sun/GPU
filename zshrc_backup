# --- [3] 系统清理与防御 (锁定环境) ---
cleanm4() {

    echo "🚀 正在执行 M4 系统深度清理..."
    sudo killall -9 idleassetsd 2>/dev/null
    # 使用引号包裹路径防止 Zsh 误解析
    sudo rm -rf "/Library/Logs/"* 2>/dev/null
    rm -rf ~/Library/Caches/* 2>/dev/null
    rm -rf ~/.cache/huggingface/hub/* 2>/dev/null
    brew cleanup --prune=all
    echo "✨ 环境清理完成！"
}

# --- [4] 同步与结项流程 ---
# 同步 dotfiles 到远程仓库并记录到 Obsidian 日志
syncm4() {
    local REPO_DIR="$HOME/M4_Repo"
    echo "🛡️ [M4 审计] 正在进入深度同步模式..."
    
    cd "$REPO_DIR" || return
    
    # 1. 强制处理子模块：如果有修改，将其纳入暂存区
    if [ -d "claude-src" ]; then
        echo "📂 发现子模块 claude-src，正在同步状态..."
        git submodule update --init --recursive
    fi
    
    # 2. 捕获核心配置：将最新的 .zshrc 覆盖到仓库备用
    cp "$HOME/.zshrc" "$REPO_DIR/zshrc_backup"
    
    # 3. 提交逻辑：使用 -a 参数自动包含所有修改过的文件，跳过手动 add
    git add .
    git commit -m "M4 Sync $(date '+%Y-%m-%d %H:%M:%S')"
    
    # 4. 推送
    git push origin main
    
    # 5. 审计记录
    obsidian append file="System Log" content="- [x] **系统备份完成**: $(date '+%Y-%m-%d %H:%M:%S') 🛡️" silent
    echo "✨ 同步完成，审计日志已更新。"
}

