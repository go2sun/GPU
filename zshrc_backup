# 快速跳转/搜索 Obsidian 笔记
function ob() {
  local VAULT_NAME="MacMiniM4"
  local TODAY=$(date "+%Y-%m-%d")
  if [ -z "$1" ]; then 
    open -a "Obsidian"
  elif [ "$1" = "daily" ]; then 
    open "obsidian://open?vault=${VAULT_NAME}&file=${TODAY}"
  else 
    open "obsidian://search?vault=${VAULT_NAME}&query=$1"
  fi
}

