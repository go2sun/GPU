# --- [2] 核心审计引擎与 AI 链路 ---

# 优化版 Qwen 启动别名（控制上下文至 16k，优化批次并开启统一 KV 缓存，杜绝 OOM，已修复双引号嵌套）
alias qwen="cd ~/llama.cpp && ./build/bin/llama-server \
  -m \"$QWEN_MODEL_PATH\" \
  --port 8080 \
  -ngl 99 \
  -c 16384 \
  -np 1 \
  -b 2048 \
  -ub 1024 \
  -fa on \
  -ctk q4_0 \
  -ctv q4_0 \
  --kv-unified \
  --cache-idle-slots \
  --repeat-penalty 1.15 \
  --frequency-penalty 0.5 \
  --presence-penalty 0.5 \
  --temperature 0.7 \
  --no-warmup \
  --cache-ram 2048 \
  -t 8 \
  --chat-template chatml"

# 2. LiteLLM 启动别名（NUSUN 终极对齐版：将 8080 的 Qwen 完美打包，以伪装名广播给 4000 端口）
alias qlite="litellm --model anthropic/qwen-35b-local:anthropic/claude-3-5-sonnet --api_base http://127.0.0.1:8080 --drop_params --port 4000" 
# 结项指令组合键
alias m4-done="cleanm4 && syncm4"

# OpenClaw 自动补全组件
[ -f "/Users/nusun/.openclaw/completions/openclaw.zsh" ] && source "/Users/nusun/.openclaw/completions/openclaw.zsh"

# --- [3] 系统清理与防御 (锁定环境) ---
cleanm4() {
    echo "🚀 正在执行 M4 系统深度清理..."
    sudo killall -9 idleassetsd 2>/dev/null
    sudo rm -rf "/Library/Logs/"* 2>/dev/null
    rm -rf ~/Library/Caches/* 2>/dev/null
    rm -rf ~/.cache/huggingface/hub/* 2>/dev/null
    brew cleanup --prune=all
    echo "✨ 环境清理完成！"
}


# --- [4] 同步与结项流程 (最终整合版) ---
syncm4() {
    local REPO_DIR="$HOME/M4_Repo"
    echo "🛡️ [M4 审计] 启动深度同步程序..."

    # 1. 模型环境预检：增加安全检测，防止脚本缺失导致中断
    if [ -x "$HOME/models/check_models.sh" ]; then
        ~/models/check_models.sh
        if [ $? -ne 0 ]; then
            echo "❌ 关键风险：模型校验失败，同步已中止。请检查 ~/models/ 目录。"
            return 1
        fi
        echo "✅ 模型健康检查通过。"
    else
        echo "⚠️ 提示：未找到预检脚本或未赋予执行权限，跳过预检。"
    fi
    
    cd "$REPO_DIR" || { echo "❌ 目录错误：找不到 $REPO_DIR"; return 1; }
    
    # 2. 处理子模块
    if [ -d "claude-src" ]; then
        echo "📂 正在同步子模块 claude-src..."
        git submodule update --init --recursive
    fi
    
    # 3. 备份配置
    cp "$HOME/.zshrc" "$REPO_DIR/zshrc_backup"
    
    # 4. Git 同步
    git add .
    git commit -m "M4 Sync $(date '+%Y-%m-%d %H:%M:%S')"
    git push origin main
    
    # 5. Obsidian 审计记录
    if [ -z "$OBSIDIAN_API_KEY" ]; then
        echo "⚠️ 警告：未检测到 OBSIDIAN_API_KEY，跳过审计日志更新。"
    else
        curl -X POST http://127.0.0.1:27123/append/ \
             -H "Authorization: Bearer $OBSIDIAN_API_KEY" \
             -H "Content-Type: text/markdown" \
             -d "- [x] **系统同步完成**: $(date '+%Y-%m-%d %H:%M:%S') 🛡️" \
             --silent --output /dev/null
        echo "✨ 同步完成，审计日志已更新。"
    fi
}

echo "🛡️ $SYSTEM_NAME 核心配置文件已高效加载。"